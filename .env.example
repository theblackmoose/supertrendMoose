# EVERYTHING IN THIS FILE IS OPTIONAL.
# `docker compose up -d --build` works with no .env at all, reachable only
# from this machine at http://localhost:19080.
#
#   cp .env.example .env      then change what you need
#   docker compose up -d      to apply a change
#
# A line left blank (e.g. `SCAN_HOUR=`) means "use the default".

# ── where it is reached ─────────────────────────────────────
# The address of this machine that other devices use: a LAN IP, a Tailscale
# IP, or a VM's own IP. This one setting controls where both services listen,
# the address your phone uses for ntfy, and the links in alerts.
#   blank or 127.0.0.1  this machine only (default)
#   192.168.1.50        reachable on that address
#   0.0.0.0             every interface; also set NTFY_PUBLIC_URL and BASE_URL
HOST_IP=

# Host ports. Non-standard on purpose, so nothing collides with 8000/8080.
APP_PORT=19080
NTFY_PORT=19081

# Only needed when HOST_IP is 0.0.0.0, or to use a hostname instead of the IP
# (e.g. a Tailscale MagicDNS name). They override what HOST_IP would give.
# BASE_URL=http://moose.example.lan:19080
# NTFY_PUBLIC_URL=http://moose.example.lan:19081

# Advanced: listen on a different address per service. Override HOST_IP.
# BIND_ADDR=
# NTFY_BIND=

# ── time zone and schedule ──────────────────────────────────
# Your time zone, as a name from the tz database, e.g.
#   Australia/Melbourne  Australia/Perth  Pacific/Auckland  Asia/Singapore
#   Europe/London  Europe/Berlin  America/New_York  America/Los_Angeles  UTC
# It sets the times in the logs and when the weekly earnings refresh runs.
# The dashboard shows times in your browser's own zone.
TZ=Australia/Melbourne

# The scan runs after every US trading day, this many minutes after the
# 16:00 New York close (15-600). It follows New York time, so daylight saving
# here or there never moves it before the close. Nothing to change for your
# zone. 60 means 17:00 New York, e.g. 07:00-09:00 in Melbourne.
SCAN_AFTER_CLOSE_MINUTES=60

# Advanced: scan at a fixed local time instead (HH:MM in TZ) on these days.
# The log warns if that time can fall before the US close in any season.
# SCAN_TIME=07:30
# SCAN_DAYS=tue-sat

# Run a scan when the container starts if the stored data is out of date.
SCAN_ON_STARTUP=true

# Commission per order, used to pre-fill the buy and sell forms so you do not
# retype your broker's flat fee. Each trade stores what you actually entered.
# DEFAULT_COMMISSION=0.99

# Opening balance for the Earnings tab's account curve. Left unset, it uses
# the most cash your recorded trades ever needed at once.
# STARTING_CASH=25000

# ── access ──────────────────────────────────────────────────
# The dashboard token is generated for you on first start; print it with
#   docker compose exec ntfyMoose moose-creds
# Set this only to replace it with your own.
# AUTH_TOKEN=

# ── notifications ───────────────────────────────────────────
# Comma-separated: ntfy, telegram, discord, email
NOTIFY_CHANNELS=ntfy

# How much the alert says.
#   full    - names the tickers, prices and stops (default)
#   minimal - counts only, e.g. "3 buy, 1 exit. Open the scanner for details."
#             Use this if your alerts might be seen on a lock screen.
NOTIFY_DETAIL=full

# ── self-hosted ntfy ────────────────────────────────────────
# Topic name (case-sensitive). Passwords are generated for you on first start.
NTFY_TOPIC=SupertrendMoose

# To publish to the public ntfy.sh instead of the bundled server:
# NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=

# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_TO=
# SMTP_TLS=true

# SMTP_PASS is better kept out of this file. A mail app password is usually
# not scoped to sending - it can read the whole mailbox - and .env contents
# show up in `docker inspect` and `docker compose config`. Write it to the
# secrets volume instead, which never touches the host. From the folder with
# docker-compose.yml (bash; DEPLOY.md has the PowerShell version):
#   read -rsp 'App password: ' p; echo; printf '%s' "$p" | \
#     docker compose exec -T ntfyMoose sh -c 'tr -d [:space:] > /secrets/smtp.pass \
#     && chown 10001 /secrets/smtp.pass && chmod 600 /secrets/smtp.pass \
#     && echo Saved $(wc -c < /secrets/smtp.pass) characters, expect 16'; unset p
# Paste, press Enter once. SMTP_PASS here still wins if set.
# Email also needs outbound TCP 587 from the server through your firewall.
# See DEPLOY.md, "Email Alerts".

# Send a short "scan completed, no signals" message on quiet days, so that
# silence means the alerting has broken rather than the market being calm.
# Worth turning on if you run only one notification channel. Suppressed when
# the scan was degraded, since the problem alert has already gone out.
# NOTIFY_HEARTBEAT=false

# ── indicators ──────────────────────────────────────────────
ATR_LEN=10
ATR_MULT=3.0
SMA_LEN=200
DI_LEN=14
ADX_LEN=14
ADX_MIN=20

# Filter applied to newly seeded tickers: none | regime | adx_rising | adx_only | full
# "none" is the default because it tested best across the watchlist.
DEFAULT_PROFILE=none
HISTORY_YEARS=5

# ── performance ─────────────────────────────────────────────
# Indicator frames held in memory. Each is roughly 125 KB for five years of
# daily bars, so 200 is about 25 MB. Raise it if you watch many more tickers.
INDICATOR_CACHE_MAX=200

# ── suitability screen ──────────────────────────────────────
MIN_AVG_VOLUME=3000000
MIN_ATR_PCT=1.5
MAX_ATR_PCT=8.0

# ── yfinance throttling (it rate-limits aggressively) ───────
FETCH_BATCH_SIZE=8
FETCH_PAUSE_SEC=1.2
FETCH_RETRIES=3
