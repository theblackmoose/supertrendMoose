#!/bin/sh
# Prints the credentials you need. They live in the /secrets volume.
echo "ntfy server     $(cat /var/lib/ntfy/public-url 2>/dev/null || echo 'see: docker compose logs ntfyMoose')"
echo "ntfy topic      ${NTFY_TOPIC:-SupertrendMoose}"
echo "ntfy username   notifications"
echo "ntfy password   $(cat /secrets/ntfy-notify.pass)"
echo "dashboard token $(cat /secrets/api-token)"
# Never printed: only whether it is there. Set it with moose-set-smtp-pass.
if [ -s /secrets/smtp.pass ]; then
  echo "smtp password   stored ($(wc -c < /secrets/smtp.pass | tr -d ' ') characters)"
else
  echo "smtp password   not stored (see moose-set-smtp-pass, or SMTP_PASS in .env)"
fi
